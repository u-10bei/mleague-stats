# ローカルで補完データ管理ページを有効にする場合は、このファイルを
# secrets.toml にコピーしてください (secrets.toml は .gitignore 済み)。
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# 環境変数でも有効にできます:
#   MLEAGUE_ADMIN=1 streamlit run app.py
#
# Streamlit Community Cloud では設定しないでください。
# 公開環境ではコンテナ再起動で書き込みが消えるため、管理機能を出す意味がありません。
enable_admin = true
